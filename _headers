# Cloudflare Pages: always check for a newer version of styles and scripts,
# so design changes and edits to assets/config.js show up straight away.
/assets/*
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Handbooks, class decks and brochures are opened through the details form: keep them out of search results
/handbook/*
  X-Robots-Tag: noindex
/classes/*
  X-Robots-Tag: noindex
/brochures/*
  X-Robots-Tag: noindex
